PORT=5000

MONGO_URI=mongodb://localhost:27017/pizza-oasis

JWT_SECRET=your_jwt_secret_key_here_oasis_pizza_secure_2025
JWT_EXPIRES_IN=7d

# Nodemailer / Gmail SMTP Credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Razorpay Test Credentials (Leave default for built-in simulation mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Default Admin Seed Account
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@oasispizza.com
ADMIN_PASSWORD=AdminPassword@123

# Client URL & Cron Schedule
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
LOW_STOCK_CRON_SCHEDULE=*/5 * * * *
